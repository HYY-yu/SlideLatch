# PostHog project token (public client token, never a personal API key).
# Without both values, analytics makes no network requests.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Keep local testing out of production analytics; opt in only when testing a configured project.
NEXT_PUBLIC_POSTHOG_CAPTURE_LOCAL=false
# Optional sanitized event logs (defaults to true in development and false in production).
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# Published Tally form. Public ID only; the widget loads after an application click.
NEXT_PUBLIC_TALLY_FORM_ID=7XqVaa
