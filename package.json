{
  "name": "slidelatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "build": "next build",
    "build:cloudflare": "CLOUDFLARE_BUILD=1 next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "dsl:check": "npm --prefix packages/ppt-dsl run check",
    "dsl:test": "npm --prefix packages/ppt-dsl test",
    "template:compile": "node --import ./packages/ppt-dsl/node_modules/tsx/dist/loader.mjs packages/ppt-dsl/src/compile-template.ts",
    "template:select": "node --import ./packages/ppt-dsl/node_modules/tsx/dist/loader.mjs packages/ppt-dsl/src/select-template.ts",
    "template:release": "node --import ./packages/ppt-dsl/node_modules/tsx/dist/loader.mjs scripts/slidelatch-release.ts",
    "deck:validate": "node --import ./packages/ppt-dsl/node_modules/tsx/dist/loader.mjs packages/ppt-dsl/src/validate-input.ts",
    "deck:generate": "node --import ./packages/ppt-dsl/node_modules/tsx/dist/loader.mjs packages/ppt-dsl/src/generate-deck.ts",
    "deck:verify": "node --import ./packages/ppt-dsl/node_modules/tsx/dist/loader.mjs packages/ppt-dsl/src/verify-deck.ts",
    "check": "npm run typecheck && npm test && npm run workflow:check && npm run dsl:check && npm run dsl:test",
    "workflow:check": "tsc --noEmit --target ES2022 --module ESNext --moduleResolution bundler --allowImportingTsExtensions --esModuleInterop --skipLibCheck scripts/slidelatch-release.ts",
    "ai:prepare": "node --experimental-strip-types scripts/slidelatch-ai.mjs prepare",
    "ai:apply": "node --experimental-strip-types scripts/slidelatch-ai.mjs apply",
    "ai:codex": "node --experimental-strip-types scripts/slidelatch-ai.mjs codex",
    "verify": "npm run check && npm run build && SLIDELATCH_DIST_DIR=.next-cloudflare npm run build:cloudflare"
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "next": "^15.1.11",
    "posthog-js": "^1.444.0",
    "pptxtojson": "^2.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.3",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@xmldom/xmldom": "^0.9.12",
    "tailwindcss": "^4.0.3",
    "typescript": "^5.7.3"
  },
  "overrides": {
    "postcss": "^8.5.32"
  },
  "type": "module"
}
